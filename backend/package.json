{
  "name": "plietsche-pluenn-backend",
  "version": "1.0.0",
  "description": "Backend for Plietsche Plünn app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "ts-node src/db/seed.ts"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.3",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "0.31.10",
    "nodemon": "3.1.10",
    "ts-node": "10.9.2",
    "typescript": "6.0.2"
  }
}
